#!/bin/csh

#=========================================================================#
#    Runs dataview on any selected field in the evolution subdirectory
#=========================================================================#

set n=$#argv

if ($n == 0) then
   echo
   echo '  Usage:   dv <field> <options>'
   echo
   echo '  Examples:'
   echo
   echo '  dv q1'
   echo '  dv q1 -mod'
   echo '  dv q1 -mod -glob'
   echo '  dv q1 -lims -1.0 1.0'
   echo '  dv q1 -notitle -cb'
   echo
   echo '  (For all options, just type "dataview")'
   echo
   exit (-1)
else
   set field=$1
endif

# Get resolution
set ng = `grep "ng=" src/parameters.f90 | awk -F= '{print $(NF-1)}' | awk -F, '{print $1}'`
@ nt = ( 2 * $ng )

if ($n != 1) then
   # Remove first element of argument list <field> to get <options>:
   shift
   dataview -ndim $nt $ng {evolution/}$field{.r4} $argv &
else
   dataview -ndim $nt $ng {evolution/}$field{.r4} &
endif
